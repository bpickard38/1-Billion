# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used from Phase 9 on (cron needs to read/write across all users, bypassing RLS).
SUPABASE_SERVICE_ROLE_KEY=
# Random string. Used to protect /api/cron/tick (Phase 9). Vercel Cron sends this automatically as `Authorization: Bearer <value>` when the env var is set.
CRON_SECRET=
# Web push (Phase 9). Generate with `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL or mailto: the push services can reach if they need to.
VAPID_SUBJECT=
# Google Calendar OAuth (Phase 10). Google Cloud Console → Credentials → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI planning chat + effort estimates. Optional; the app works without them.
OPENAI_API_KEY=
OPENAI_MODEL=
# 64 hex chars (32 bytes). Encrypts stored Canvas tokens. Keep stable across deploys.
CANVAS_TOKEN_ENCRYPTION_KEY=
